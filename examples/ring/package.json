{
  "name": "rust_d3_geo_example_ring",
  "version": "0.1.0",
  "description": "Render a uniform arrow of rings using orthographic and stereographic projections.",
  "main": "index.js",
  "bin": {
    "create-wasm-app": ".bin/create-wasm-app.js"
  },
  "scripts": {
    "build": "rimraf dist pkg && RUST_LOG=info webpack",
    "lint": "tslint './js/*.ts'",
    "serve": "serve dist",
    "start": "rimraf pkg && RUST_LOG=info webpack-dev-server --open",
    "test": "cargo test && wasm-pack test --headless"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinfrances107/rust_d3_geo.git"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "rust",
    "webpack"
  ],
  "author": "Martin Frances <martinfrances107@hotmail.com>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/martinfrances107/rust_d3_geo/issues"
  },
  "homepage": "https://github.com/martinfrances107/rust_d3_geo/#readme",
  "dependencies": {
    "d3": "7.9",
    "rimraf": "6",
    "serve": "14",
    "webpack": ">=5.101.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "devDependencies": {
    "@types/d3": "7",
    "@wasm-tool/wasm-pack-plugin": "1.7",
    "compression-webpack-plugin": "11.1.0",
    "copy-webpack-plugin": "13.0.0",
    "@types/d3-selection": "3.0.11",
    "@types/topojson-client": "3.1.5",
    "eslint-plugin-import": "2.32",
    "eslint-plugin-n": "17",
    "eslint-plugin-promise": "7",
    "eslint-webpack-plugin": "5.0.2",
    "ts-loader": "9",
    "tslint": "5.20.1",
    "typescript": "5.9.2",
    "webpack-cli": "6.0.1"
  }
}